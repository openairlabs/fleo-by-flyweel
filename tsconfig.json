{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["tui/*"]
    },
    "outDir": "dist"
  },
  "include": ["tui/**/*.ts", "tui/**/*.tsx", "tests/tui/**/*.ts", "tests/tui/**/*.tsx"],
  "exclude": ["node_modules", "dist", "venv", "output"]
}

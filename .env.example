# ============================================================================
# Fleo by Flyweel: Environment Configuration
# Run `npx fleo` (or `fleo setup`) for an interactive TUI wizard!
# ============================================================================

# ----------------------------------------------------------------------------
# OPTION 1: SIMPLE 1-KEY QUICKSTART (Recommended for most users)
# One OpenRouter key powers every agent role end-to-end (including Sonar SERP).
# Get a key at: https://openrouter.ai/keys
# ----------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Optional but recommended: Direct Perplexity key preserves native Sonar
# search_domain_filter and raw citation metadata for Reddit/Quora/SERP mining.
# Get a key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Optional: Direct Google AI Studio key for low-latency Gemini Flash SEO passes.
# If unset, Fleo routes SEO/editor passes through OpenRouter automatically.
# Get a key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ----------------------------------------------------------------------------
# OPTION 2: GRANULAR PER-AGENT API KEYS & MODEL OVERRIDES (Advanced / Teams)
# Set any of these to isolate spend, rate limits, or direct vendor keys per role.
# Any unset role falls back cleanly to OPENROUTER_API_KEY above.
# ----------------------------------------------------------------------------

# 1. Research Agent (SERP + Reddit + Quora community mining)
# FLEO_RESEARCH_API_KEY=
# FLEO_RESEARCH_MODEL=sonar-reasoning-pro
# FLEO_DEEP_RESEARCH_MODEL=sonar-deep-research

# 2. Writer / Draft Agent (3-part long-form article generation)
# FLEO_DRAFT_API_KEY=
# FLEO_DRAFT_MODEL=openai/gpt-6-sol

# 3. Editorial Polish / Humanizer Agent
# FLEO_POLISH_API_KEY=
# FLEO_POLISH_MODEL=anthropic/claude-sonnet-5.5

# 4. SEO & Section Editor Agent (Titles, Meta, TL;DR, H2 surgical edits)
# FLEO_SEO_API_KEY=
# FLEO_SEO_MODEL=google/gemini-3.8-flash

# 5. Light / Classifier / Judge Agent (Intent, topic framing, GEO quality judge)
# FLEO_LIGHT_API_KEY=
# FLEO_LIGHT_MODEL=openai/gpt-6-luna

# 6. Embeddings Agent (Semantic dedupe + GSC topic-cluster estimation)
# FLEO_EMBED_API_KEY=
# FLEO_EMBED_MODEL=qwen/qwen3-embedding-8b

# Custom HTTPS gateways (FLEO_<ROLE>_BASE_URL) are intentionally ignored in workspace
# .env files so untrusted repositories cannot redirect shell-exported API keys.
# Export FLEO_<ROLE>_BASE_URL in your shell environment when routing to a custom gateway.

# 7. Brand Extractor Agent (Website crawl -> BrandProfile synthesis in wizard)
# FLEO_EXTRACTOR_API_KEY=
# FLEO_EXTRACTOR_MODEL=openai/gpt-6-luna

# 8. Decisions / Audit Agent (TypeSafe Jev via OpenRouter Decisions API)
# FLEO_DECISIONS_API_KEY=
# FLEO_JEV_ENABLED=1

# Global model tier preset: balanced (default, ~$0.23/post) | max (~$0.76/post)
MODEL_TIER=balanced

# ----------------------------------------------------------------------------
# OPTIONAL ENRICHMENT & PUBLISHING INTEGRATIONS
# ----------------------------------------------------------------------------

# Google Search Console (cannibalization check + traffic opportunity score gate)
# GOOGLE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
# GSC_PROPERTY_URL=sc-domain:yourdomain.com

# Interfaze (credible web/academic index enrichment for --style research)
# INTERFAZE_API_KEY=

# IndexNow (instant Bing / Copilot / Perplexity ping on publish)
# INDEXNOW_KEY=
# INDEXNOW_KEY_LOCATION=https://yourdomain.com/your_indexnow_key.txt

# Connected Website Target (auto-configured by `fleo setup` when linking a repo)
# FLEO_TARGET_FRAMEWORK=auto
# FLEO_SITE_REPO_PATH=
# FLEO_BLOG_CONTENT_PATH=
# FLEO_BLOG_ASSETS_PATH=
# OUTPUT_DIR=output
